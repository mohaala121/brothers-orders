<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head><body><script>const ar="",en="";let l="ar";try{l=localStorage.getItem("brothers_ui_lang")||"ar"}catch(_){};document.open();document.write(new TextDecoder().decode(Uint8Array.from(atob(l==="en"?en:ar),c=>c.charCodeAt(0))));document.close();</script></body></html>
