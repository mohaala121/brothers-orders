category": "Gum"}, {"id": "xc67", "name": "ALP Nicotine Pouches 6mg 5ct - Wintergreen", "category": "Nicotine"}, {"id": "xc68", "name": "Air Bar NEX Disposable 6500 Puffs (10 pack) - Cool Mint", "category": "Vape"}, {"id": "xc69", "name": "Zyn Nicotine Pouches US 3mg (5ct) - Wintergreen", "category": "Nicotine"}, {"id": "xc70", "name": "Zyn Nicotine Pouches US 6mg (5ct) - Black Cherry", "category": "Nicotine"}, {"id": "xc71", "name": "Zyn Nicotine Pouches US 6mg (5ct) - Spearmint", "category": "Nicotine"}, {"id": "xc72", "name": "Zyn Nicotine Pouches US 6mg (5ct) - Smooth", "category": "Nicotine"}];

const translations={"نظام الطلبيات والموردين": "Ordering & supplier management", "طلبية جديدة": "New order", "الموردون": "Suppliers", "الأسعار والمقارنة": "Prices & comparison", "سجل الطلبيات": "Order history", "التذكيرات": "Reminders", "النسخ الاحتياطي": "Backup", "طلبيات اليوم": "Today's orders", "جدول التذكيرات": "Reminder schedule", "إنشاء طلبية": "Create order", "المورد": "Supplier", "بحث عن صنف": "Search products", "اكتب اسم الصنف أو القسم": "Enter product or category", "ملاحظة للطلبية": "Order note", "مثلاً: التوصيل صباحاً": "e.g. Morning delivery", "صنف": "items", "القسم": "Category", "كل الأقسام": "All categories", "المفضلة": "Favorites", "المختارة": "Selected", "معاينة الطلبية": "Order preview", "تفريغ الطلبية": "Clear order", "اختر المورد وأدخل الكميات...": "Select a supplier and enter quantities...", "نسخ": "Copy", "مشاركة": "Share", "حفظ الطلبية": "Save order", "إضافة مورد": "Add supplier", "اسم المورد": "Supplier name", "الهاتف / واتساب (اختياري)": "Phone / WhatsApp (optional)", "رقم الهاتف": "Phone number", "إضافة المورد": "Add supplier", "الموردون المسجلون": "Registered suppliers", "إدخال أسعار المورد": "Enter supplier prices", "كل الأسعار تبدأ فارغة. أدخل السعر وحجم العبوة كما يظهران في فاتورة المورد. لا تتم مقارنة العبوات المختلفة تلقائياً إلا بعد التأكد من وحدة المقارنة.": "Prices start blank. Enter the price and pack size shown on the supplier invoice. Different packs are not automatically compared unless the comparison unit is verified.", "اسم الصنف": "Product name", "مقارنة أسعار منتج": "Compare product prices", "المنتج": "Product", "الطلبيات المحفوظة": "Saved orders", "جدول الموردين": "Supplier schedule", "للتنبيه عند إغلاق التطبيق، أضف الجدول إلى تقويم الآيفون واسمح بإشعارات التقويم. التنبيهات داخل التطبيق لا تعمل في الخلفية.": "For reminders when the app is closed, add the schedule to your iPhone calendar and enable calendar notifications. In-app reminders do not run in the background.", "البيانات محفوظة محلياً في Safari على هذا الجهاز. صدّر نسخة احتياطية بانتظام، خاصة قبل تغيير الهاتف أو حذف بيانات المتصفح.": "Data is stored locally in Safari on this device. Export backups regularly, especially before changing phones or clearing browser data.", "تصدير نسخة": "Export backup", "استيراد نسخة": "Import backup", "مسح بيانات التطبيق": "Reset app data", "ملاحظات الإصدار الأول": "First release notes", "القائمة مستوردة من ملفك السابق. أيمن وLoboy مضافان مسبقاً، والأسعار الجديدة فارغة. زر المشاركة يفتح قائمة المشاركة في iPhone ولا يرسل واتساب تلقائياً. التطبيق يحفظ البيانات على نفس الجهاز والمتصفح.": "The catalog was imported from your previous file. Ayman and Loboy are preloaded, and new prices are blank. Share opens the iPhone share menu without automatically sending WhatsApp messages. Data stays on the same device and browser.", "استيراد أسعار Xclusive من ملف خاص": "Import Xclusive prices from file", "مراجعة الطلبية": "Review order", "أضف مورداً أولاً": "Add a supplier first", "لا توجد أصناف مطابقة.": "No matching products.", "تفريغ الطلبية الحالية؟": "Clear the current order?", "أدخل كمية لصنف واحد على الأقل.": "Enter a quantity for at least one product.", "تم نسخ الطلبية.": "Order copied.", "انسخ النص المحدد يدوياً.": "Copy the selected text manually.", "الطلبية فارغة.": "The order is empty.", "تم نسخ الطلبية؛ الصقها في واتساب.": "Order copied; paste it into WhatsApp.", "تعذر فتح المشاركة في هذا المتصفح.": "Sharing is unavailable in this browser.", "تم حفظ الطلبية في السجل.": "Order saved to history.", "اكتب اسم المورد.": "Enter a supplier name.", "لا يوجد رقم هاتف": "No phone number", "حذف": "Delete", "لم تضف مورداً بعد.": "No suppliers added yet.", "حذف المورد وأسعاره؟": "Delete this supplier and its prices?", "السعر بالدولار": "Price in USD", "فارغ": "Blank", "حجم العبوة": "Pack size", "مثلاً 4/1 gal case": "e.g. 4/1 gal case", "وحدة المقارنة": "Comparison unit", "مثلاً lb أو each": "e.g. lb or each", "أضف مورداً أولاً.": "Add a supplier first.", "حجم العبوة غير محدد": "Pack size not specified", "أقل سعر مسجل": "Lowest recorded price", "لا توجد أسعار مسجلة لهذا المنتج.": "No prices recorded for this product.", "عرض": "View", "لا توجد طلبيات محفوظة.": "No saved orders.", "تم استيراد النسخة.": "Backup imported.", "ملف النسخة الاحتياطية غير صالح.": "Invalid backup file.", "سيتم حذف الموردين والأسعار والطلبيات من هذا الجهاز. هل أنت متأكد؟": "This will delete suppliers, prices and orders from this device. Are you sure?", "الأحد": "Sunday", "الاثنين": "Monday", "الثلاثاء": "Tuesday", "الأربعاء": "Wednesday", "الخميس": "Thursday", "الجمعة": "Friday", "السبت": "Saturday", "تم الإرسال": "Sent", "موعد الطلب اليوم": "Order due today", "إلغاء التأكيد": "Undo confirmation", "لا توجد طلبيات مجدولة اليوم.": "No orders scheduled today.", "تفعيل التذكير": "Enable reminder", "وقت التذكير": "Reminder time", "إضافة إلى تقويم الآيفون": "Add to iPhone calendar", "إذا غيّرت الجدول، احذف الحدث المتكرر القديم من التقويم قبل إضافة الجديد.": "If you change the schedule, delete the old recurring calendar event before adding the new one.", "فعّل التذكير واختر الأيام أولاً.": "Enable the reminder and select days first.", "طلبية": "Order", "جهز وأرسل الطلبية من Brothers Orders": "Prepare and send the order from Brothers Orders", "تم استيراد أسعار Xclusive": "Xclusive prices imported", "تعذر استيراد الملف": "Could not import file", "من": "of"};
let uiLanguage='ar';try{uiLanguage=localStorage.getItem('brothers_ui_language')==='en'?'en':'ar'}catch(e){}
function tr(t){return uiLanguage==='en'?(translations[t]||t):t}
const originalText=new WeakMap();
const originalAttrs=new WeakMap();
function translateUI(){
 const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let n;
 while(n=walker.nextNode()){
  if(n.parentElement.closest('script,style,textarea,.pname,.pcat,.supplierrow b,.historyrow b,[data-sched] b,#langAR,#langEN'))continue;
  let old=originalText.get(n);if(!old||n.nodeValue!==old.last)old={source:n.nodeValue,last:n.nodeValue};
  let v=old.source;let trimmed=v.trim();let translated=translations[trimmed];
  if(!translated){translated=trimmed.replace(/^📅 طلبيات اليوم$/, "📅 Today's orders").replace(/^★ المفضلة$/, '★ Favorites').replace(/^نظام الطلبيات والموردين(.*)$/, 'Ordering & supplier management$1').replace(/^(\d+) من (\d+) صنف$/, '$1 of $2 items').replace(/^(\d+) صنف$/, '$1 items').replace(/^(.* · )تم الإرسال$/, '$1Sent').replace(/^(.* · )موعد الطلب اليوم$/, '$1Order due today');}
  let next=uiLanguage==='en'?v.replace(trimmed,translated):v;if(n.nodeValue!==next)n.nodeValue=next;old.last=next;originalText.set(n,old);
 }
 document.querySelectorAll('[placeholder],[aria-label]').forEach(el=>{let map=originalAttrs.get(el)||{};for(let a of ['placeholder','aria-label']){if(!el.hasAttribute(a))continue;let v=el.getAttribute(a),o=map[a];if(!o||v!==o.last)o={source:v,last:v};let next=tr(o.source);if(v!==next)el.setAttribute(a,next);o.last=next;map[a]=o}originalAttrs.set(el,map)});
}
function setLanguage(l){uiLanguage=l;try{localStorage.setItem('brothers_ui_language',l)}catch(e){}document.documentElement.lang=l;document.documentElement.dir=l==='ar'?'rtl':'ltr';document.getElementById('langAR').classList.toggle('selected',l==='ar');document.getElementById('langEN').classList.toggle('selected',l==='en');translateUI()}

const STORE='brothers_deli_orders_v1';
const $=id=>document.getElementById(id);
let db=load();let qty={};
function seedAyman(){if(!db.aymanInitialized){let a=db.suppliers.find(x=>["أيمن","ايمن","ayman"].includes(x.name.toLowerCase()));if(!a)db.suppliers.push({id:"ayman",name:"أيمن (Ayman)",phone:"",ayman:true});else a.ayman=true;db.aymanInitialized=true;}}
seedAyman();seedLoboy();seedXclusive();
function seedLoboy(){if(!db.loboyInitialized){let a=db.suppliers.find(x=>/loboy/i.test(x.name));if(!a)db.suppliers.push({id:"loboy",name:"Loboy Wholesale Foods",phone:"7186176611",loboy:true});else a.loboy=true;db.loboyInitialized=true;}db.favorites=db.favorites||{};db.drafts=db.drafts||{};}
function seedXclusive(){if(!db.xclusiveInitialized){let a=db.suppliers.find(x=>/xclusive/i.test(x.name));if(!a)db.suppliers.push({id:"xclusive",name:"Xclusive Distributor",phone:"",xclusive:true,schedule:{enabled:false,days:[],time:"12:00"}});else a.xclusive=true;db.xclusiveInitialized=true;}}
function load(){try{let d=JSON.parse(localStorage.getItem(STORE)||'null');if(d&&Array.isArray(d.suppliers)&&d.prices&&Array.isArray(d.orders))return d}catch(e){}return{suppliers:[],prices:{},orders:[],customProducts:[]}}
function save(){localStorage.setItem(STORE,JSON.stringify(db))}
function products(){return CATALOG.concat(AYMAN_EXTRA,LOBOY_EXTRA,XCLUSIVE_ITEMS,db.customProducts||[])}
function supplierProducts(id){return supplier(id)?.ayman?AYMAN_ITEMS:supplier(id)?.loboy?LOBOY_ITEMS:supplier(id)?.xclusive?XCLUSIVE_ITEMS:products()}
function product(id){return products().find(p=>p.id===id)}
function supplier(id){return db.suppliers.find(s=>s.id===id)}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function key(s,p){return s+'_'+p}
function price(s,p){return db.prices[key(s,p)]||{amount:'',pack:'',unit:''}}
function money(v){return '$'+Number(v).toFixed(2)}
function tab(name){document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.tab===name));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===name));if(name==='order'){renderProducts();renderToday()}if(name==='schedule')renderSchedule();if(name==='suppliers')renderSuppliers();if(name==='prices')renderPrices();if(name==='history')renderHistory()}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>tab(b.dataset.tab));$('bottomOrder').onclick=()=>tab('order');$('bottomPrices').onclick=()=>{tab('order');$('reviewTitle').scrollIntoView({behavior:'smooth',block:'center'})};
function fillSelects(){let oldOrder=$('orderSupplier').value,oldPrice=$('priceSupplier').value;let opts=db.suppliers.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('');$('orderSupplier').innerHTML=opts||'<option value="">أضف مورداً أولاً</option>';$('priceSupplier').innerHTML=opts||'<option value="">أضف مورداً أولاً</option>';if(db.suppliers.some(s=>s.id===oldOrder))$('orderSupplier').value=oldOrder;if(db.suppliers.some(s=>s.id===oldPrice))$('priceSupplier').value=oldPrice;}
let onlyFav=false,onlyChosen=false;
function pict(p){let t=(p.name+" "+p.category).toLowerCase();for(let [r,e] of [[/glove|bag|napkin|paper|foil|aluminum|container|lid|cup|straw|disposable/,"📦"],[/cheese/,"🧀"],[/egg/,"🥚"],[/chicken|wing|poultry/,"🍗"],[/fish|salmon|tuna|shrimp|seafood/,"🐟"],[/fries|potato|hashbrown/,"🍟"],[/burger/,"🍔"],[/bread|wrap|roll|bagel/,"🥖"],[/cake|dessert/,"🍰"],[/sauce|dressing|mayo|mustard|ketchup/,"🥫"],[/beef|meat|steak|ham|bacon|sausage|pork/,"🥩"],[/milk|cream|butter|dairy/,"🥛"],[/coffee|tea/,"☕"],[/fruit|mango|berry|berries|pineapple/,"🍓"],[/produce|vegetable|salad|lettuce/,"🥬"],[/frozen/,"❄️"]])if(r.test(t))return e;return "🛒";}
function draft(){let id=$("orderSupplier").value;if(id){db.drafts[id]={qty:{...qty},note:$("orderNote").value};db.lastSupplier=id;save()}}
function restoreDraft(){let d=db.drafts[$("orderSupplier").value]||{};qty={...(d.qty||{})};$("orderNote").value=d.note||"";}
function renderProducts(){fillSelects();let sid=$('orderSupplier').value,q=$('productSearch').value.trim().toLowerCase();let cf=$('categoryFilter'),old=cf.value,cats=[...new Set(supplierProducts(sid).map(p=>p.category))].sort();cf.innerHTML='<option value="">كل الأقسام</option>'+cats.map(c=>`<option>${esc(c)}</option>`).join('');if(cats.includes(old))cf.value=old;let list=supplierProducts(sid).filter(p=>(p.name+' '+p.category).toLowerCase().includes(q)&&(!cf.value||p.category===cf.value)&&(!onlyFav||db.favorites[key(sid,p.id)])&&(!onlyChosen||qty[p.id]>0));$('catalogCount').textContent=`${list.length} من ${supplierProducts(sid).length} صنف`; $('productList').innerHTML=list.map(p=>{let pr=sid?price(sid,p.id):null;let label=pr&&pr.amount!==''?` · <span class="price">${money(pr.amount)}</span>`:'';return `<div class="product"><div class="productinfo"><span class="pic" aria-hidden="true">${pict(p)}</span><div><div class="pname">${esc(p.name)}</div><div class="pcat">${esc(p.category)}${label}</div><button class="star" data-fav="${p.id}" aria-label="المفضلة">${db.favorites[key(sid,p.id)]?"★":"☆"}</button></div></div><div class="stepper" dir="ltr" data-stepper="${p.id}"><button type="button" data-delta="-1" aria-label="Decrease quantity" ${qty[p.id]>0?'':'disabled'}>−</button><output aria-live="polite">${qty[p.id]||0}</output><button type="button" data-delta="1" aria-label="Increase quantity">+</button></div></div>`}).join('')||'<div class="empty">لا توجد أصناف مطابقة.</div>';document.querySelectorAll('[data-fav]').forEach(b=>b.onclick=()=>{let k=key(sid,b.dataset.fav);if(db.favorites[k])delete db.favorites[k];else db.favorites[k]=true;save();renderProducts()});document.querySelectorAll('[data-stepper]').forEach(e=>{let id=e.dataset.stepper;e.querySelectorAll('button').forEach(b=>b.onclick=()=>{let n=Math.max(0,(Number(qty[id])||0)+Number(b.dataset.delta));if(n>0)qty[id]=n;else delete qty[id];e.querySelector('output').textContent=n;e.querySelector('[data-delta="-1"]').disabled=n===0;preview();draft();if(onlyChosen&&n===0)renderProducts()})});preview()}
function orderText(){let s=supplier($('orderSupplier').value),items=Object.entries(qty).filter(x=>x[1]>0);if(!s||!items.length)return '';let a=['BROTHERS DELI & GROCERY','ORDER FOR: '+s.name,'DATE: '+new Date().toLocaleDateString('en-US'),''];items.forEach(([id,n])=>{let p=product(id);if(p)a.push(p.name+' — '+n)});let note=$('orderNote').value.trim();if(note)a.push('','NOTE: '+note);a.push('','Thank you.');return a.join('\n')}
function preview(){$('preview').value=orderText();$('itemCount').textContent=Object.keys(qty).length+' صنف'}
$('orderSupplier').onchange=()=>{restoreDraft();$('categoryFilter').value='';renderProducts();draft()};$('categoryFilter').onchange=renderProducts;$('favFilter').onclick=()=>{onlyFav=!onlyFav;$('favFilter').classList.toggle('selected',onlyFav);renderProducts()};$('chosenFilter').onclick=()=>{onlyChosen=!onlyChosen;$('chosenFilter').classList.toggle('selected',onlyChosen);renderProducts()};$('clearDraft').onclick=()=>{if(confirm(tr("تفريغ الطلبية الحالية؟"))){qty={};$('orderNote').value='';draft();renderProducts()}};$('productSearch').oninput=renderProducts;$('orderNote').oninput=()=>{preview();draft()};
$('copyOrder').onclick=async()=>{let t=$('preview').value;if(!t)return alert(tr("أدخل كمية لصنف واحد على الأقل."));try{await navigator.clipboard.writeText(t);alert(tr("تم نسخ الطلبية."))}catch(e){$('preview').select();alert(tr("انسخ النص المحدد يدوياً."))}};
$('shareOrder').onclick=async()=>{let t=$('preview').value;if(!t)return alert(tr("الطلبية فارغة."));if(navigator.share){try{await navigator.share({title:'Brothers Deli Order',text:t})}catch(e){}}else{try{await navigator.clipboard.writeText(t);alert(tr("تم نسخ الطلبية؛ الصقها في واتساب."))}catch(e){alert(tr("تعذر فتح المشاركة في هذا المتصفح."))}}};
$('saveOrder').onclick=()=>{let t=$('preview').value;if(!t)return alert(tr("الطلبية فارغة."));let s=supplier($('orderSupplier').value);db.orders.unshift({id:'o'+Date.now(),supplier:s.name,text:t,date:new Date().toISOString()});save();alert(tr("تم حفظ الطلبية في السجل."))};
$('addSupplier').onclick=()=>{let name=$('supplierName').value.trim();if(!name)return alert(tr("اكتب اسم المورد."));db.suppliers.push({id:'s'+Date.now(),name,phone:$('supplierPhone').value.trim()});save();$('supplierName').value='';$('supplierPhone').value='';renderSuppliers();renderProducts();renderPrices()};
function renderSuppliers(){fillSelects();$('supplierList').innerHTML=db.suppliers.map(s=>`<div class="supplierrow"><div><b>${esc(s.name)}</b><div class="muted">${esc(s.phone||'لا يوجد رقم هاتف')}</div></div><button class="danger small" data-remove-s="${s.id}">حذف</button></div>`).join('')||'<div class="empty">لم تضف مورداً بعد.</div>';document.querySelectorAll('[data-remove-s]').forEach(b=>b.onclick=()=>{if(confirm(tr("حذف المورد وأسعاره؟"))){let id=b.dataset.removeS;db.suppliers=db.suppliers.filter(s=>s.id!==id);Object.keys(db.prices).filter(k=>k.startsWith(id+'_')).forEach(k=>delete db.prices[k]);save();renderSuppliers();renderProducts();renderPrices()}})}
function renderPrices(){fillSelects();let sid=$('priceSupplier').value,q=$('priceSearch').value.trim().toLowerCase(),list=supplierProducts(sid).filter(p=>(p.name+' '+p.category).toLowerCase().includes(q));$('priceList').innerHTML=list.map(p=>{let v=sid?price(sid,p.id):{amount:'',pack:'',unit:''};return `<div class="pricecard"><b>${esc(p.name)}</b><div class="grid" style="margin-top:8px"><div class="field"><label>السعر بالدولار</label><input type="number" min="0" step=".01" placeholder="فارغ" data-amount="${p.id}" value="${esc(v.amount)}"></div><div class="field"><label>حجم العبوة</label><input placeholder="مثلاً 4/1 gal case" data-pack="${p.id}" value="${esc(v.pack)}"></div><div class="field"><label>وحدة المقارنة</label><input placeholder="مثلاً lb أو each" data-unit="${p.id}" value="${esc(v.unit)}"></div></div></div>`}).join('');document.querySelectorAll('[data-amount],[data-pack],[data-unit]').forEach(e=>e.onchange=()=>{if(!sid)return alert(tr("أضف مورداً أولاً."));let id=e.dataset.amount||e.dataset.pack||e.dataset.unit,k=key(sid,id);let a=document.querySelector(`[data-amount="${id}"]`),p=document.querySelector(`[data-pack="${id}"]`),u=document.querySelector(`[data-unit="${id}"]`);db.prices[k]={amount:a.value,pack:p.value,unit:u.value};save();renderComparison()});renderComparison()}
$('priceSupplier').onchange=renderPrices;$('priceSearch').oninput=renderPrices;
function renderComparison(){let previous=$('compareProduct').value;let list=products();$('compareProduct').innerHTML=list.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('');if(list.some(p=>p.id===previous))$('compareProduct').value=previous;let id=$('compareProduct').value;let rows=db.suppliers.map(s=>({s,v:price(s.id,id)})).filter(x=>x.v.amount!==''&&Number.isFinite(Number(x.v.amount)));rows.sort((a,b)=>Number(a.v.amount)-Number(b.v.amount));let comparable=rows.length>1&&rows.every(x=>x.v.pack.trim()&&x.v.unit.trim()&&x.v.pack.trim().toLowerCase()===rows[0].v.pack.trim().toLowerCase()&&x.v.unit.trim().toLowerCase()===rows[0].v.unit.trim().toLowerCase());let lowest=comparable?Number(rows[0].v.amount):null;$('comparison').innerHTML=rows.length?rows.map(x=>`<div class="supplierrow"><div><b>${esc(x.s.name)}</b><div class="muted">${esc(x.v.pack||'حجم العبوة غير محدد')}${x.v.unit?' · '+esc(x.v.unit):''}</div></div><div class="price ${Number(x.v.amount)===lowest?'best':''}">${money(x.v.amount)} ${Number(x.v.amount)===lowest?'<span class="pill">أقل سعر مسجل</span>':''}</div></div>`).join(''):'<div class="empty">لا توجد أسعار مسجلة لهذا المنتج.</div>'}
$('compareProduct').onchange=renderComparison;
function renderHistory(){$('historyList').innerHTML=db.orders.map(o=>`<div class="historyrow"><div><b>${esc(o.supplier)}</b><div class="muted">${new Date(o.date).toLocaleString()}</div></div><div class="row"><button class="secondary small" data-show="${o.id}">عرض</button><button class="danger small" data-del="${o.id}">حذف</button></div></div>`).join('')||'<div class="empty">لا توجد طلبيات محفوظة.</div>';document.querySelectorAll('[data-show]').forEach(b=>b.onclick=()=>{let o=db.orders.find(x=>x.id===b.dataset.show);if(o){tab('order');$('preview').value=o.text;$('reviewTitle').scrollIntoView({block:'center'})}});document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{db.orders=db.orders.filter(x=>x.id!==b.dataset.del);save();renderHistory()})}
$('exportData').onclick=()=>{let blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='brothers-orders-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!Array.isArray(d.suppliers)||!d.prices||!Array.isArray(d.orders))throw 0;db=d;seedAyman();seedLoboy();seedXclusive();qty={};save();renderSuppliers();renderProducts();renderPrices();renderHistory();alert(tr("تم استيراد النسخة."))}catch(_){alert(tr("ملف النسخة الاحتياطية غير صالح."))}};
$('resetData').onclick=()=>{if(confirm(tr("سيتم حذف الموردين والأسعار والطلبيات من هذا الجهاز. هل أنت متأكد؟"))){localStorage.removeItem(STORE);db=load();seedAyman();seedLoboy();seedXclusive();qty={};renderSuppliers();renderProducts();renderPrices();renderHistory()}};
fillSelects();if(db.suppliers.some(x=>x.id===db.lastSupplier))$('orderSupplier').value=db.lastSupplier;restoreDraft();save();renderProducts();renderSuppliers();renderPrices();renderHistory();if('serviceWorker'in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('./sw.js').catch(()=>{});

const daysAR=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const daysICS=['SU','MO','TU','WE','TH','FR','SA'];
function schedule(s){return s.schedule||{enabled:!!s.ayman,days:s.ayman?[0,4]:[],time:'12:00',done:''}}
function dateKey(){let d=new Date();return `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`}
function renderToday(){let rows=db.suppliers.filter(s=>{let r=schedule(s);return r.enabled&&r.days.includes(new Date().getDay())});$('todayOrders').innerHTML=rows.length?rows.map(s=>{let r=schedule(s);return `<div class="supplierrow"><div><b>${esc(s.name)}</b><div class="muted">${esc(r.time)} · ${r.done===dateKey()?'تم الإرسال':'موعد الطلب اليوم'}</div></div><button class="secondary small" data-done="${esc(s.id)}">${r.done===dateKey()?'إلغاء التأكيد':'تم الإرسال'}</button></div>`}).join(''):'<p class="muted">لا توجد طلبيات مجدولة اليوم.</p>';document.querySelectorAll('[data-done]').forEach(b=>b.onclick=()=>{let s=supplier(b.dataset.done),r=schedule(s);r.done=r.done===dateKey()?'':dateKey();s.schedule=r;save();renderToday()})}
function renderSchedule(){ $('scheduleList').innerHTML=db.suppliers.map((s,i)=>{let r=schedule(s);return `<div class="card" data-sched="${i}"><b>${esc(s.name)}</b><div style="margin:10px 0"><label><input style="width:auto" type="checkbox" data-enable ${r.enabled?'checked':''}> تفعيل التذكير</label></div><div style="display:flex;flex-wrap:wrap;gap:12px">${daysAR.map((d,j)=>`<label><input style="width:auto" type="checkbox" data-day="${j}" ${r.days.includes(j)?'checked':''}> ${d}</label>`).join('')}</div><div class="field" style="margin-top:12px"><label>وقت التذكير</label><input type="time" value="${esc(r.time)}" data-time></div><button class="secondary" data-calendar>إضافة إلى تقويم الآيفون</button><p class="help">إذا غيّرت الجدول، احذف الحدث المتكرر القديم من التقويم قبل إضافة الجديد.</p></div>`}).join('');document.querySelectorAll('[data-sched]').forEach(el=>{let s=db.suppliers[Number(el.dataset.sched)];function update(){s.schedule={...schedule(s),enabled:el.querySelector('[data-enable]').checked,days:[...el.querySelectorAll('[data-day]:checked')].map(x=>Number(x.dataset.day)),time:el.querySelector('[data-time]').value||'12:00'};save();renderToday()}el.onchange=update;el.querySelector('[data-calendar]').onclick=()=>{update();exportCalendar(s)}})}
function exportCalendar(s){let r=schedule(s);if(!r.enabled||!r.days.length)return alert(tr("فعّل التذكير واختر الأيام أولاً."));let [h,m]=r.time.split(':').map(Number),d=new Date();d.setHours(h,m,0,0);while(!r.days.includes(d.getDay())||d<=new Date())d.setDate(d.getDate()+1);let pad=n=>String(n).padStart(2,'0'),stamp=x=>`${x.getFullYear()}${pad(x.getMonth()+1)}${pad(x.getDate())}T${pad(x.getHours())}${pad(x.getMinutes())}00`,safe=x=>String(x).replace(/[\r\n]/g,' ').replace(/[,;\\]/g,'\\$&');let end=new Date(d.getTime()+15*60000);let lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Brothers Orders//Schedule//EN','CALSCALE:GREGORIAN','BEGIN:VEVENT','UID:brothers-'+s.id+'@orders','DTSTAMP:'+new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d+Z$/,'Z'),'DTSTART:'+stamp(d),'DTEND:'+stamp(end),'RRULE:FREQ=WEEKLY;BYDAY='+r.days.map(j=>daysICS[j]).join(','),'SUMMARY:'+safe(tr('طلبية')+' '+s.name),'DESCRIPTION:'+safe(tr('جهز وأرسل الطلبية من Brothers Orders')),'BEGIN:VALARM','ACTION:DISPLAY','TRIGGER:PT0M','DESCRIPTION:Order reminder','END:VALARM','END:VEVENT','END:VCALENDAR'];let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([lines.join('\r\n')+'\r\n'],{type:'text/calendar'}));a.download='brothers-'+s.id+'.ics';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000)}
renderToday();document.addEventListener('visibilitychange',()=>{if(!document.hidden)renderToday()});setInterval(renderToday,60000);

$('xcPriceBtn').onclick=()=>$('xcPriceFile').click();$('xcPriceFile').onchange=async e=>{try{let f=e.target.files[0];if(!f)return;let d=JSON.parse(await f.text());if(d.type!=='xclusive-prices')throw Error();let a=db.suppliers.find(x=>x.xclusive);if(!a)throw Error();for(let p of XCLUSIVE_ITEMS){if(Object.hasOwn(d.prices,p.id)&&/^\d+(\.\d+)?$/.test(String(d.prices[p.id]))){let k=key(a.id,p.id);db.prices[k]={...price(a.id,p.id),amount:String(d.prices[p.id])}}}save();renderProducts();renderPrices();alert(tr("تم استيراد أسعار Xclusive"))}catch(e){alert(tr("تعذر استيراد الملف"))} };
setLanguage(uiLanguage);new MutationObserver(translateUI).observe(document.body,{subtree:true,childList:true,characterData:true});
</script></body></html>
