<!doctype html>
<html lang="ar" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#153c2d"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="apple-mobile-web-app-title" content="Brothers Orders">
<link rel="manifest" href="manifest.webmanifest"><link rel="apple-touch-icon" href="icon.svg"><title>Brothers Deli & Grocery</title>
<style>
:root{--green:#174b37;--green2:#24684b;--bg:#f3f6f3;--ink:#18251e;--muted:#68776e;--line:#e0e8e2;--red:#b33d32}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}header{position:sticky;top:0;z-index:5;background:linear-gradient(130deg,#153c2d,#24684b);color:#fff;padding:calc(16px + env(safe-area-inset-top)) 16px 15px}.brand{font-size:20px;font-weight:800}.subtitle{font-size:12px;opacity:.82;margin-top:4px}main{max-width:920px;margin:auto;padding:12px 12px 95px}.tabs{display:flex;gap:7px;overflow-x:auto;position:sticky;top:86px;background:var(--bg);z-index:4;padding:5px 0 12px}.tab{white-space:nowrap;border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:30px;padding:10px 13px;font-weight:700}.tab.active{background:var(--green);color:white;border-color:var(--green)}.panel{display:none}.panel.active{display:block}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px;box-shadow:0 2px 8px #142a1b08}h2{font-size:17px;margin:0 0 12px}.muted,.help{color:var(--muted);font-size:12px;line-height:1.55}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.field{margin-bottom:10px}.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}input,select,textarea{font:inherit;width:100%;min-width:0;border:1px solid #d6e0d9;border-radius:11px;background:#fff;color:var(--ink);padding:11px}textarea{min-height:115px;resize:vertical}button{font:inherit;border:0;border-radius:11px;padding:11px 13px;background:var(--green);color:#fff;font-weight:700}button.secondary{background:#eaf1ec;color:var(--green)}button.danger{background:#fff0ee;color:var(--red)}button.small{padding:7px 10px;font-size:12px}.row{display:flex;gap:8px;align-items:center}.between{justify-content:space-between}.pill{font-size:11px;background:#eaf3ed;color:var(--green);border-radius:20px;padding:4px 8px;font-weight:700}.product{display:grid;grid-template-columns:minmax(0,1fr) 86px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.product:last-child{border:0}.pname{font-size:14px;font-weight:700}.pcat{font-size:11px;color:var(--muted);margin-top:3px}.product input{padding:9px 5px;text-align:center}.supplierrow,.historyrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}.supplierrow:last-child,.historyrow:last-child{border:0}.pricecard{border:1px solid var(--line);border-radius:12px;padding:11px;margin:9px 0}.best{color:#147044;font-weight:800}.empty{text-align:center;color:var(--muted);padding:20px 8px}.price{direction:ltr;display:inline-block;font-weight:800}.bottom{position:fixed;bottom:0;left:0;right:0;z-index:6;background:#ffffffed;backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:9px 12px calc(9px + env(safe-area-inset-bottom))}.bottomin{max-width:920px;margin:auto;display:flex;gap:8px}.bottomin button{flex:1}hr{border:0;border-top:1px solid var(--line);margin:14px 0}@media(min-width:700px){.product{grid-template-columns:1fr 110px}.grid{grid-template-columns:repeat(3,1fr)}}
.product{grid-template-columns:minmax(0,1fr) 132px}.stepper{display:flex;align-items:center;justify-content:space-between;gap:4px}.stepper button{width:44px;height:44px;padding:0;font-size:24px;line-height:1;touch-action:manipulation}.stepper button:disabled{opacity:.35}.stepper output{min-width:30px;text-align:center;font-weight:800;font-variant-numeric:tabular-nums}.tools{display:flex;gap:6px;align-items:center;margin:12px 0;flex-wrap:wrap}.tools select{flex:1;min-width:110px}.selected{background:#174b37!important;color:white!important}.productinfo{display:flex;align-items:center;gap:7px;min-width:0}.productinfo>div{min-width:0;overflow-wrap:anywhere}.pic{font-size:24px;background:#eef4ef;border-radius:10px;width:37px;height:42px;display:grid;place-items:center;flex:none}.star{background:none;color:#a16a00;padding:2px 6px;font-size:20px}.product{gap:6px;grid-template-columns:minmax(0,1fr) 118px}.stepper button{width:40px;height:44px}.stepper output{min-width:24px}#reviewTitle{scroll-margin-top:150px}</style></head><body>
<header><div style="float:inline-end;display:flex;gap:5px" dir="ltr"><button type="button" id="langAR" class="small secondary" onclick="setLanguage('ar')">عربي</button><button type="button" id="langEN" class="small secondary" onclick="setLanguage('en')">English</button></div><div class="brand">Brothers Deli & Grocery</div><div class="subtitle">نظام الطلبيات والموردين — 1.6</div></header>
<main>
<nav class="tabs"><button class="tab active" data-tab="order">طلبية جديدة</button><button class="tab" data-tab="suppliers">الموردون</button><button class="tab" data-tab="prices">الأسعار والمقارنة</button><button class="tab" data-tab="history">سجل الطلبيات</button><button class="tab" data-tab="schedule">التذكيرات</button><button class="tab" data-tab="backup">النسخ الاحتياطي</button></nav>
<section class="panel active" id="order"><div class="card"><h2>📅 طلبيات اليوم</h2><div id="todayOrders"></div><button class="secondary small" onclick="tab('schedule')">جدول التذكيرات</button></div><div class="card"><h2>إنشاء طلبية</h2><div class="grid"><div class="field"><label>المورد</label><select id="orderSupplier"></select></div><div class="field"><label>بحث عن صنف</label><input id="productSearch" placeholder="اكتب اسم الصنف أو القسم"></div></div><div class="field"><label>ملاحظة للطلبية</label><input id="orderNote" placeholder="مثلاً: التوصيل صباحاً"></div><div class="row between"><span class="muted" id="catalogCount"></span><span class="pill" id="itemCount">0 صنف</span></div><div class="tools"><select id="categoryFilter" aria-label="القسم"><option value="">كل الأقسام</option></select><button class="secondary small" id="favFilter">★ المفضلة</button><button class="secondary small" id="chosenFilter">المختارة</button></div><div id="productList"></div></div>
<div class="card"><h2 id="reviewTitle">معاينة الطلبية</h2><button class="danger small" id="clearDraft">تفريغ الطلبية</button><textarea id="preview" readonly placeholder="اختر المورد وأدخل الكميات..."></textarea><div class="row" style="margin-top:9px"><button id="copyOrder">نسخ</button><button class="secondary" id="shareOrder">مشاركة</button><button class="secondary" id="saveOrder">حفظ الطلبية</button></div></div></section>
<section class="panel" id="suppliers"><div class="card"><h2>إضافة مورد</h2><div class="grid"><div class="field"><label>اسم المورد</label><input id="supplierName" placeholder="اسم المورد"></div><div class="field"><label>الهاتف / واتساب (اختياري)</label><input id="supplierPhone" inputmode="tel" placeholder="رقم الهاتف"></div></div><button id="addSupplier">إضافة المورد</button></div><div class="card"><h2>الموردون المسجلون</h2><div id="supplierList"></div></div></section>
<section class="panel" id="prices"><div class="card"><h2>إدخال أسعار المورد</h2><p class="help">كل الأسعار تبدأ فارغة. أدخل السعر وحجم العبوة كما يظهران في فاتورة المورد. لا تتم مقارنة العبوات المختلفة تلقائياً إلا بعد التأكد من وحدة المقارنة.</p><div class="grid"><div class="field"><label>المورد</label><select id="priceSupplier"></select></div><div class="field"><label>بحث عن صنف</label><input id="priceSearch" placeholder="اسم الصنف"></div></div><div id="priceList"></div></div><div class="card"><h2>مقارنة أسعار منتج</h2><div class="field"><label>المنتج</label><select id="compareProduct"></select></div><div id="comparison"></div></div></section>
<section class="panel" id="history"><div class="card"><h2>الطلبيات المحفوظة</h2><div id="historyList"></div></div></section>
<section class="panel" id="schedule"><div class="card"><h2>جدول الموردين</h2><p class="help">للتنبيه عند إغلاق التطبيق، أضف الجدول إلى تقويم الآيفون واسمح بإشعارات التقويم. التنبيهات داخل التطبيق لا تعمل في الخلفية.</p><div id="scheduleList"></div></div></section><section class="panel" id="backup"><div class="card"><h2>النسخ الاحتياطي</h2><p class="help">البيانات محفوظة محلياً في Safari على هذا الجهاز. صدّر نسخة احتياطية بانتظام، خاصة قبل تغيير الهاتف أو حذف بيانات المتصفح.</p><div class="row"><button id="exportData">تصدير نسخة</button><button class="secondary" id="importBtn">استيراد نسخة</button><input id="importFile" type="file" accept="application/json" hidden></div><hr><button class="danger" id="resetData">مسح بيانات التطبيق</button></div><div class="card"><h2>ملاحظات الإصدار الأول</h2><p class="help">القائمة مستوردة من ملفك السابق. أيمن وLoboy مضافان مسبقاً، والأسعار الجديدة فارغة. زر المشاركة يفتح قائمة المشاركة في iPhone ولا يرسل واتساب تلقائياً. التطبيق يحفظ البيانات على نفس الجهاز والمتصفح.</p></div></section>
<input type="file" id="xcPriceFile" accept=".json,application/json" hidden><button type="button" id="xcPriceBtn" class="secondary">استيراد أسعار Xclusive من ملف خاص</button></main><div class="bottom"><div class="bottomin"><button id="bottomOrder">طلبية جديدة</button><button class="secondary" id="bottomPrices">مراجعة الطلبية</button></div></div>
